# Copy this file to .env and fill in real values. .env is already gitignored (.env*) —
# never commit real credentials. This file is only used by scripts/live-trade.js, which
# runs locally on your own PC and is deliberately not wired into any GitHub Actions
# workflow (a CI runner's IP can't be allow-listed on a Bitget API key).

# Bitget API key with TRADE permission only — disable withdrawal permission on the key,
# and set an IP allowlist to this machine's IP if possible.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Set to "true" to route requests through Bitget's demo/simulated-trading environment
# (requires a separate Demo API Key generated from Demo mode in the Bitget UI — a live
# key will NOT work with this flag). Leave unset/false for real-money trading.
BITGET_DEMO_TRADING=false

# USDT margin committed per trade. Leave unset or "full" to commit (~95% of) whatever the
# account's current available balance is each trade — see resolveMarginUsdt() in
# scripts/live-trade.js. Set a number instead to cap it regardless of balance.
BITGET_MARGIN_USDT=full

BITGET_SYMBOL=BTCUSDT
